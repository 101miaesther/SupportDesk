{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {

    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Include Node.js types and avoid accidentally including other packages.
    "types": ["node"],

    // Disable emitting output during  which is used for type-checking only.
    "noEmit": true,

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
